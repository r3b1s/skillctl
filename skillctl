#!/bin/bash
set -euo pipefail

SKILLCTL_DIR="${HOME}/.config/skillctl"
REPOS_DIR="${SKILLCTL_DIR}/repos"
IMPORTS_FILE="${SKILLCTL_DIR}/imports"

# Harness name -> skill directory pattern (relative, <name> is placeholder)
declare -A HARNESSES=(
  ["Claude Code"]=".claude/skills/<name>"
  ["OpenAI Codex"]=".agents/skills/<name>"
  ["OpenCode"]=".agents/skills/<name>"
  ["KiloCode"]=".kilocode/skills/<name>"
  ["Gemini CLI"]=".agents/skills/<name>"
  ["pi"]=".pi/skills/<name>"
  ["amp"]=".agents/skills/<name>"
  ["Cursor"]=".cursor/skills/<name>"
  ["cline"]=".cline/skills/<name>"
  ["goose"]=".goose/skills/<name>"
  ["Warp"]=".agents/skills/<name>"
  ["GitHub Copilot"]=".github/skills/<name>"
  ["Qwen"]=".qwen/skills/<name>"
)

# Special shortcut that resolves to the .agents/ path shared by most harnesses
UNIVERSAL_HARNESS="Most harnesses (.agents/) — Codex, Gemini, amp, Warp, OpenCode, etc. Not Claude Code, Cursor, KiloCode, or others with unique paths"

die() { echo "error: $*" >&2; exit 1; }

require_gum() {
  command -v gum &>/dev/null || die "gum is required but not installed. Install it: https://github.com/charmbracelet/gum"
}

ensure_dirs() {
  mkdir -p "$REPOS_DIR"
}

# ── import tracking ──────────────────────────────────────────────────────────
# Format: path=repo/skill  (one per line)

import_add() {
  local path="$1" origin="$2"
  ensure_dirs
  # Remove existing entry for this path, then append
  if [[ -f "$IMPORTS_FILE" ]]; then
    local tmp
    tmp=$(grep -v "^${path}=" "$IMPORTS_FILE" || true)
    printf '%s\n' "$tmp" > "$IMPORTS_FILE"
  fi
  echo "${path}=${origin}" >> "$IMPORTS_FILE"
}

import_remove() {
  local path="$1"
  [[ -f "$IMPORTS_FILE" ]] || return 0
  local tmp
  tmp=$(grep -v "^${path}=" "$IMPORTS_FILE" || true)
  printf '%s\n' "$tmp" > "$IMPORTS_FILE"
}

import_is_tracked() {
  local path="$1"
  [[ -f "$IMPORTS_FILE" ]] && grep -q "^${path}=" "$IMPORTS_FILE" 2>/dev/null
}

import_get_origin() {
  local path="$1"
  [[ -f "$IMPORTS_FILE" ]] || { echo ""; return; }
  grep "^${path}=" "$IMPORTS_FILE" 2>/dev/null | head -1 | cut -d= -f2- || echo ""
}

import_list_all() {
  [[ -f "$IMPORTS_FILE" ]] && grep -v '^$' "$IMPORTS_FILE" 2>/dev/null || true
}

# Extract repo name from a URL or path
repo_name_from() {
  local source="$1"
  basename "${source%.git}"
}

# List all skill names inside a repo
list_skills_in_repo() {
  local repo_dir="$1"
  if [[ -d "${repo_dir}/skills" ]]; then
    find "${repo_dir}/skills" -mindepth 1 -maxdepth 1 -type d -exec basename {} \; | sort
  fi
}

# Resolve harness skill dir for a given skill name and base path
harness_skill_dir() {
  local harness="$1" skill_name="$2" base="$3"
  local pattern="${HARNESSES[$harness]}"
  local rel="${pattern/<name>/$skill_name}"
  echo "${base}/${rel}"
}

# Find all existing symlinks pointing to a skill across all harnesses
find_links_for_skill() {
  local skill_name="$1" base="$2"
  local seen=()
  for harness in "${!HARNESSES[@]}"; do
    local target
    target="$(harness_skill_dir "$harness" "$skill_name" "$base")"
    # deduplicate paths (multiple harnesses share .agents/)
    local already=false
    for s in "${seen[@]+"${seen[@]}"}"; do
      [[ "$s" == "$target" ]] && already=true && break
    done
    $already && continue
    seen+=("$target")
    if [[ -L "$target" ]]; then
      echo "$target"
    fi
  done
}

# Find all imported (copied) skill directories across all harnesses
find_imports_for_skill() {
  local skill_name="$1" base="$2"
  local seen=()
  for harness in "${!HARNESSES[@]}"; do
    local target
    target="$(harness_skill_dir "$harness" "$skill_name" "$base")"
    local already=false
    for s in "${seen[@]+"${seen[@]}"}"; do
      [[ "$s" == "$target" ]] && already=true && break
    done
    $already && continue
    seen+=("$target")
    if [[ -d "$target" && ! -L "$target" ]] && import_is_tracked "$target"; then
      echo "$target"
    fi
  done
}

# Get unique harness dirs for selected harnesses
unique_harness_dirs() {
  local skill_name="$1" base="$2"
  shift 2
  local harness_names=("$@")
  local seen=()
  for harness in "${harness_names[@]}"; do
    local target
    # Resolve the universal shortcut to .agents/skills/<name>
    if [[ "$harness" == "$UNIVERSAL_HARNESS" ]]; then
      local rel=".agents/skills/${skill_name}"
      target="${base}/${rel}"
    else
      target="$(harness_skill_dir "$harness" "$skill_name" "$base")"
    fi
    local already=false
    for s in "${seen[@]+"${seen[@]}"}"; do
      [[ "$s" == "$target" ]] && already=true && break
    done
    $already && continue
    seen+=("$target")
    echo "$target"
  done
}

# ── install ──────────────────────────────────────────────────────────────────

cmd_install() {
  [[ $# -lt 1 ]] && die "usage: skillctl install <url|local-path>"
  ensure_dirs

  local source="$1"
  local name
  name="$(repo_name_from "$source")"

  if [[ -d "${REPOS_DIR}/${name}" ]]; then
    die "repo '${name}' is already installed"
  fi

  if [[ -d "$source" ]]; then
    # Local directory — validate it has a skills/ folder
    [[ -d "${source}/skills" ]] || die "local directory '${source}' has no skills/ folder"
    cp -r "$source" "${REPOS_DIR}/${name}"
    echo "copied '${source}' to ${REPOS_DIR}/${name}"
  else
    # Treat as URL — clone
    git clone "$source" "${REPOS_DIR}/${name}"
  fi

  local skills
  skills="$(list_skills_in_repo "${REPOS_DIR}/${name}")"
  if [[ -z "$skills" ]]; then
    echo "warning: no skills found in ${name}/skills/"
  else
    echo "installed skills:"
    echo "$skills" | sed 's/^/  /'
  fi
}

# ── interactive skill picker ─────────────────────────────────────────────────

pick_skills() {
  local all_skills=()
  for repo_dir in "${REPOS_DIR}"/*/; do
    [[ -d "$repo_dir" ]] || continue
    local repo_name
    repo_name="$(basename "$repo_dir")"
    while IFS= read -r skill; do
      [[ -n "$skill" ]] && all_skills+=("${repo_name}/${skill}")
    done < <(list_skills_in_repo "$repo_dir")
  done

  [[ ${#all_skills[@]} -eq 0 ]] && die "no skills installed"

  local selected
  selected="$(printf '%s\n' "${all_skills[@]}" | gum choose --no-limit --header "Select skills to link:")"
  [[ -z "$selected" ]] && die "no skills selected"
  echo "$selected"
}

pick_harnesses() {
  local harness_names
  harness_names="$(printf '%s\n' "$UNIVERSAL_HARNESS" "${!HARNESSES[@]}" | sort)"

  local selected
  selected="$(echo "$harness_names" | gum choose --no-limit --header "Select harnesses:")"
  [[ -z "$selected" ]] && die "no harnesses selected"
  echo "$selected"
}

# ── link ─────────────────────────────────────────────────────────────────────

cmd_link() {
  require_gum

  local skill_arg="" is_global=false project_dir="" import_mode=false

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --global)  is_global=true; shift ;;
      --import)  import_mode=true; shift ;;
      --project) project_dir="$2"; shift 2 ;;
      *)         skill_arg="$1"; shift ;;
    esac
  done

  local base
  if $is_global; then
    base="$HOME"
  else
    base="${project_dir:-$(pwd)}"
  fi

  # Determine skills to link
  local skills_to_link=()
  if [[ -n "$skill_arg" ]]; then
    # Validate format repo/skill
    if [[ "$skill_arg" == */* ]]; then
      local repo_part="${skill_arg%%/*}"
      local skill_part="${skill_arg#*/}"
      [[ -d "${REPOS_DIR}/${repo_part}/skills/${skill_part}" ]] || die "skill '${skill_arg}' not found"
      skills_to_link+=("$skill_arg")
    else
      # Search all repos for this skill name
      local found=false
      for repo_dir in "${REPOS_DIR}"/*/; do
        local rn
        rn="$(basename "$repo_dir")"
        if [[ -d "${repo_dir}/skills/${skill_arg}" ]]; then
          skills_to_link+=("${rn}/${skill_arg}")
          found=true
        fi
      done
      $found || die "skill '${skill_arg}' not found in any repo"
    fi
  else
    while IFS= read -r line; do
      [[ -n "$line" ]] && skills_to_link+=("$line")
    done < <(pick_skills)
  fi

  # Pick harnesses
  local selected_harnesses=()
  while IFS= read -r line; do
    [[ -n "$line" ]] && selected_harnesses+=("$line")
  done < <(pick_harnesses)

  # Create symlinks or copies
  for entry in "${skills_to_link[@]}"; do
    local repo_part="${entry%%/*}"
    local skill_part="${entry#*/}"
    local skill_source="${REPOS_DIR}/${repo_part}/skills/${skill_part}"

    while IFS= read -r target_dir; do
      mkdir -p "$(dirname "$target_dir")"

      # Handle existing target
      if [[ -L "$target_dir" || -e "$target_dir" ]]; then
        if $import_mode; then
          if ! gum confirm "Overwrite ${target_dir}? Any local changes will be lost."; then
            echo "skipped: ${target_dir}"
            continue
          fi
          rm -rf "$target_dir"
        elif [[ -L "$target_dir" ]]; then
          echo "already linked: ${target_dir}"
          continue
        else
          echo "skipped (non-symlink exists): ${target_dir}"
          continue
        fi
      fi

      if $import_mode; then
        mkdir -p "$target_dir"
        cp -r "${skill_source}/." "$target_dir/"
        import_add "$target_dir" "$entry"
        echo "imported: ${target_dir} (from ${entry})"
      else
        ln -s "$skill_source" "$target_dir"
        echo "linked: ${target_dir} -> ${skill_source}"
      fi
    done < <(unique_harness_dirs "$skill_part" "$base" "${selected_harnesses[@]}")
  done
}

# ── unlink ───────────────────────────────────────────────────────────────────

cmd_unlink() {
  require_gum

  local skill_arg="" is_global=false project_dir=""

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --global) is_global=true; shift ;;
      --project) project_dir="$2"; shift 2 ;;
      *) skill_arg="$1"; shift ;;
    esac
  done

  local base
  if $is_global; then
    base="$HOME"
  else
    base="${project_dir:-$(pwd)}"
  fi

  local skills_to_unlink=()
  if [[ -n "$skill_arg" ]]; then
    local skill_name="${skill_arg#*/}"
    [[ "$skill_arg" == */* ]] || skill_name="$skill_arg"
    skills_to_unlink+=("$skill_name")
  else
    # Interactive: show only currently linked or imported skills
    local active_skills=()
    for repo_dir in "${REPOS_DIR}"/*/; do
      [[ -d "$repo_dir" ]] || continue
      while IFS= read -r skill; do
        [[ -n "$skill" ]] || continue
        local links imports
        links="$(find_links_for_skill "$skill" "$base")"
        imports="$(find_imports_for_skill "$skill" "$base")"
        [[ -n "$links" || -n "$imports" ]] && active_skills+=("$skill")
      done < <(list_skills_in_repo "$repo_dir")
    done

    [[ ${#active_skills[@]} -eq 0 ]] && die "no linked or imported skills found"

    local selected
    selected="$(printf '%s\n' "${active_skills[@]}" | sort -u | gum choose --no-limit --header "Select skills to unlink:")"
    [[ -z "$selected" ]] && die "no skills selected"
    while IFS= read -r line; do
      [[ -n "$line" ]] && skills_to_unlink+=("$line")
    done <<< "$selected"
  fi

  for skill_name in "${skills_to_unlink[@]}"; do
    # Remove symlinks
    while IFS= read -r link; do
      rm "$link"
      echo "unlinked: ${link}"
    done < <(find_links_for_skill "$skill_name" "$base")

    # Remove imports (with warning)
    while IFS= read -r import_path; do
      echo ""
      gum style --foreground 196 "WARNING: ${import_path} is an imported copy, not a symlink."
      gum style --foreground 196 "Any changes you've made to these files will be lost."
      echo ""
      if gum confirm "Remove ${import_path}?"; then
        rm -rf "$import_path"
        import_remove "$import_path"
        echo "removed: ${import_path}"
      else
        echo "skipped: ${import_path}"
      fi
    done < <(find_imports_for_skill "$skill_name" "$base")
  done
}

# ── uninstall ────────────────────────────────────────────────────────────────

cmd_uninstall() {
  [[ $# -lt 1 ]] && die "usage: skillctl uninstall <repo-name>"

  local name="$1"
  local repo_dir="${REPOS_DIR}/${name}"
  [[ -d "$repo_dir" ]] || die "repo '${name}' not found"

  # Remove all symlinks pointing into this repo across home and common project locations
  while IFS= read -r skill; do
    [[ -n "$skill" ]] || continue
    # Find symlinks everywhere that point into this repo
    while IFS= read -r link; do
      local target
      target="$(readlink "$link")"
      if [[ "$target" == "${repo_dir}/"* ]]; then
        rm "$link"
        echo "unlinked: ${link}"
      fi
    done < <(find "$HOME" -type l -lname "${repo_dir}/*" 2>/dev/null || true)
  done < <(list_skills_in_repo "$repo_dir")

  rm -rf "$repo_dir"
  echo "uninstalled: ${name}"
}

# ── update ───────────────────────────────────────────────────────────────────

cmd_update() {
  local found=false
  for repo_dir in "${REPOS_DIR}"/*/; do
    [[ -d "$repo_dir" ]] || continue
    found=true
    local name
    name="$(basename "$repo_dir")"

    if [[ -d "${repo_dir}/.git" ]]; then
      echo "updating ${name}..."
      git -C "$repo_dir" pull --ff-only 2>&1 | sed 's/^/  /'
    else
      echo "skipping ${name} (not a git repo)"
    fi
  done

  $found || echo "no repos installed"

  # Warn about imported skills that may be out of date
  local stale=()
  while IFS= read -r line; do
    [[ -n "$line" ]] || continue
    local path origin
    path="${line%%=*}"
    origin="${line#*=}"
    [[ -d "$path" ]] && stale+=("  ${path}  (imported from ${origin})")
  done < <(import_list_all)

  if [[ ${#stale[@]} -gt 0 ]]; then
    echo ""
    echo "${#stale[@]} imported skill(s) may be out of date:"
    printf '%s\n' "${stale[@]}"
    echo ""
    echo "Imported skills are detached copies and are not updated automatically."
    echo "To refresh, re-run the original link command with --import, e.g.:"
    echo "  skillctl link <repo/skill> --import --global"
  fi
}

# ── list ─────────────────────────────────────────────────────────────────────

cmd_list() {
  local found=false

  for repo_dir in "${REPOS_DIR}"/*/; do
    [[ -d "$repo_dir" ]] || continue
    found=true
    local repo_name
    repo_name="$(basename "$repo_dir")"

    echo -e "\033[1;34m${repo_name}\033[0m"

    while IFS= read -r skill; do
      [[ -n "$skill" ]] || continue

      local home_links home_imports has_any=false
      home_links="$(find_links_for_skill "$skill" "$HOME")"
      home_imports="$(find_imports_for_skill "$skill" "$HOME")"

      if [[ -n "$home_links" ]]; then
        has_any=true
        echo -e "  \033[1;32m${skill}\033[0m (global, linked)"
        while IFS= read -r link; do
          echo -e "    \033[0;32m-> ${link}\033[0m"
        done <<< "$home_links"
      fi

      if [[ -n "$home_imports" ]]; then
        has_any=true
        echo -e "  \033[1;33m${skill}\033[0m (global, imported)"
        while IFS= read -r imp; do
          echo -e "    \033[0;33m=> ${imp}\033[0m"
        done <<< "$home_imports"
      fi

      if ! $has_any; then
        echo -e "  \033[0;37m${skill}\033[0m (not linked)"
      fi
    done < <(list_skills_in_repo "$repo_dir")
    echo
  done

  $found || echo "no repos installed"
}

# ── main ─────────────────────────────────────────────────────────────────────

usage() {
  cat <<'EOF'
skillctl - manage agent skills across harnesses

usage:
  skillctl install <url|local-path>       clone/copy a skill repo
  skillctl link [skill] [--global] [--project <path>] [--import]
  skillctl unlink [skill] [--global] [--project <path>]
  skillctl uninstall <repo-name>          remove repo and all symlinks
  skillctl update                         git pull all repos
  skillctl list                           show repos, skills, and link status

flags:
  --import   copy files instead of symlinking (link command only)
  --global   target $HOME instead of current directory
  --project  target a specific project directory

notes:
  unlink removes both symlinks and imported copies. When removing an
  imported copy, you will be warned that any local changes will be lost.
EOF
}

case "${1:-}" in
  install)   shift; cmd_install "$@" ;;
  link)      shift; cmd_link "$@" ;;
  unlink)    shift; cmd_unlink "$@" ;;
  uninstall) shift; cmd_uninstall "$@" ;;
  update)    shift; cmd_update "$@" ;;
  list)      shift; cmd_list "$@" ;;
  -h|--help|help) usage ;;
  "") usage; exit 1 ;;
  *) die "unknown command: $1" ;;
esac
